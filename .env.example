# 1. Supabase (Base de datos real)
# Obtenidos en tu proyecto Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL="https://tu-proyecto.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="tu-clave-anon-publica"

# Clave Service Role (Solo se usa en el servidor Next.js para el panel administrativo seguro)
# NUNCA compartas ni expongas esta clave al navegador.
SUPABASE_SERVICE_ROLE_KEY="tu-clave-service-role-secreta"

# 2. Seguridad del Panel Administrativo de los Novios
# Clave maestra para acceder a /admin (cámbiala por una contraseña segura)
ADMIN_SECRET_KEY="EstefaniRicardo2026!"

# 3. URL pública del sitio (para generar enlaces de WhatsApp y compartir)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
